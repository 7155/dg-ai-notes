---
// src/components/ModuleCard.astro
// 目录行：章节列表中的一行（编辑型目录风格）。
// 精简结构：序号 + 标题 + 字数。整行可点。
import { getVariantUrl, getModuleStats } from '../utils/collection';
import type { GroupedChapter } from '../utils/collection';

interface Props { chapter: GroupedChapter; }
const { chapter } = Astro.props;

const primary = chapter.tsEntry ?? chapter.pythonEntry;
if (!primary) {
  return Astro.redirect('/404');
}
const { data } = primary;
const stats = getModuleStats(primary);

const tsUrl = chapter.tsEntry ? getVariantUrl(chapter.tsEntry) : null;
const pyUrl = chapter.pythonEntry ? getVariantUrl(chapter.pythonEntry) : null;
const isPractice = chapter.book === 'practice';
const readUrl = tsUrl ?? pyUrl ?? '/404';
const wordCount = stats.wordCount;
---

<a class="toc-row" href={readUrl}>
  <span class="toc-num">{data.module}</span>
  <span class="toc-title">{data.title}</span>
  <span class="toc-aside">
    {wordCount > 0 && <span class="toc-words">{wordCount}字</span>}
  </span>
</a>

<style>
.toc-row {
  position: relative;
  display: grid;
  grid-template-columns: 44px 1fr auto;
  gap: var(--space-4);
  align-items: baseline;
  padding: 0 var(--space-3) 0 var(--space-2);
  border-bottom: var(--border-w) solid var(--rule);
  text-decoration: none;
  /* flex: 1 由父级 .series-list 控制，让每行均分高度 */
  transition: background var(--dur-fast) var(--ease);
}

/* hover 时的书签强调线：从左侧延伸 */
.toc-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--accent);
  transform: scaleY(0);
  transform-origin: center;
  transition: transform var(--dur-base) var(--ease);
}
.toc-row:hover::before {
  transform: scaleY(1);
}
.toc-row:hover {
  background: var(--accent-soft);
}
.toc-row:focus-visible {
  outline: var(--outline-w) solid var(--accent);
  outline-offset: -2px;
}

/* 序号：等宽小字，固定宽度对齐 */
.toc-num {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--soft);
  letter-spacing: 0.06em;
  padding-top: 6px;
  text-transform: uppercase;
  transition: color var(--dur-fast) var(--ease);
}
.toc-row:hover .toc-num {
  color: var(--accent);
}

/* 标题：display 大字 */
.toc-title {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: var(--fs-h3);
  line-height: 1.3;
  color: var(--ink-strong);
  padding: var(--space-2) 0;
  transition: color var(--dur-fast) var(--ease);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.toc-row:hover .toc-title {
  color: var(--accent);
}

/* 右侧：字数 */
.toc-aside {
  display: flex;
  align-items: baseline;
  padding-top: 6px;
  white-space: nowrap;
}
.toc-words {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--soft);
}

@media (max-width: 640px) {
  .toc-row {
    grid-template-columns: 34px 1fr auto;
    gap: var(--space-3);
  }
  .toc-title {
    font-size: var(--fs-body);
  }
}
</style>
