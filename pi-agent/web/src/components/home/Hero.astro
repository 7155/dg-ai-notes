---
// src/components/home/Hero.astro
// Hero 区：超大 Pi Agent 标题 + 副标题 + 右侧项目卡片。
// 克制装饰，靠字号张力与不对称构图建立设计感。
import BookIntro from './BookIntro.astro';

const piAgentDesc = 'Pi Agent（pi.dev）是 OpenClaw 等应用的运行时底座——一套真正能上线的 Agent 工程参考实现。';
const piAgentGithub = 'https://github.com/earendil-works/pi';
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-left">
      <h1 class="hero-title">Pi Agent</h1>
      <p class="hero-sub">
        从上手到深入<em>，</em><br/>
        <span class="hero-sub-accent">一本读懂 Agent 内核</span>
      </p>
    </div>

    <aside class="hero-right">
      <BookIntro
        name="Pi Agent"
        description={piAgentDesc}
        githubUrl={piAgentGithub}
      />
    </aside>
  </div>
</section>

<style>
.hero {
  padding: var(--space-16) var(--space-6) var(--space-12);
}

.hero-grid {
  max-width: var(--page-max);
  margin: 0 auto;
  /* 与底部 dual-tracks 同构：1fr 1fr，保证右列起点对齐 */
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: center;
}

.hero-left {
  text-align: left;
}

/* 超大主标题：撑满左侧，视觉统治力 */
.hero-title {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(64px, 10vw, 140px);
  line-height: 0.9;
  letter-spacing: -0.04em;
  margin: 0;
  color: var(--ink-strong);
}

/* 副标题：错落两行，斜体衬线，橙色重音 */
.hero-sub {
  font-family: var(--font-display);
  font-weight: 400;
  font-style: italic;
  font-size: clamp(22px, 2.6vw, 36px);
  line-height: 1.25;
  color: var(--muted);
  margin: var(--space-5) 0 0;
}
.hero-sub em {
  font-style: normal;
  color: var(--accent);
}
.hero-sub-accent {
  color: var(--accent);
}

@media (max-width: 900px) {
  .hero { padding: var(--space-12) var(--space-6) var(--space-8); }
  .hero-grid {
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }
}
</style>
