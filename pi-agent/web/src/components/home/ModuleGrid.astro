---
// src/components/home/ModuleGrid.astro
// 单系列目录列：编辑型/杂志风。
// 系列标题区（罗马序号 + 大标题 + tagline + 版本行）+ 章节目录行列表。
// flex: 1 撑满并排容器，与另一列等高；目录行均分剩余高度，最后一行底边对齐。
import ModuleCard from '../ModuleCard.astro';
import { getPublishedModules, groupByChapter, SERIES_META } from '../../utils/collection';

interface Props { book: 'internals' | 'practice'; }
const { book } = Astro.props;

const meta = SERIES_META[book];
const all = await getPublishedModules(book);
const chapters = groupByChapter(all);

const roman = book === 'internals' ? 'I' : 'II';
const badge = meta.badge;
---

<section class={`series series-${book}`}>
  <header class="series-head">
    <span class="series-roman">{roman}</span>
    <div class="series-headtext">
      <p class="series-eyebrow">
        {meta.eyebrow}
        {badge && <span class="series-badge">{badge}</span>}
      </p>
      <h2 class="series-title">{meta.label}</h2>
      <p class="series-lead">{meta.tagline}</p>
    </div>
  </header>

  <div class="series-list">
    {chapters.map(ch => <ModuleCard chapter={ch} />)}
  </div>
</section>

<style>
.series {
  /* flex: 1 让两列在并排容器中等高（align-items: stretch 生效） */
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-4);
  min-width: 0;
}
/* 右列（实战上手）左侧加垂直分隔线，强化双轨并列感 */
.series-practice {
  border-left: var(--border-w) solid var(--rule-strong);
}

/* 系列标题：罗马序号 + 标题文字块 */
.series-head {
  display: flex;
  gap: var(--space-4);
  align-items: flex-start;
  padding-bottom: var(--space-5);
  margin-bottom: var(--space-3);
  border-bottom: 2px solid var(--ink-strong);
}
.series-roman {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 56px;
  line-height: 0.9;
  color: var(--accent);
  font-style: italic;
  flex-shrink: 0;
}
.series-headtext {
  padding-top: var(--space-2);
  /* 两列 headtext 内容行数一致（eyebrow/title/lead/variant），自然等高 */
}
.series-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--soft);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin: 0 0 var(--space-1);
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
/* NEW 角标：小而精的强调标识 */
.series-badge {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  color: var(--paper);
  background: var(--accent);
  padding: 2px 6px;
  border-radius: 3px;
  letter-spacing: 0.08em;
  line-height: 1;
}
.series-title {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: var(--fs-h2);
  line-height: 1.1;
  margin: 0 0 var(--space-2);
  color: var(--ink-strong);
}
.series-lead {
  font-size: var(--fs-small);
  line-height: 1.5;
  color: var(--muted);
  margin: 0;
}

/* 章节列表：flex: 1 填满系列剩余高度；行均分 */
.series-list {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.series-list > :global(*) {
  flex: 1 1 0;
}

@media (max-width: 960px) {
  .series { padding: var(--space-8) var(--space-4); }
  /* 堆叠时去掉垂直分隔线，改为上下间用顶部边框 */
  .series-practice {
    border-left: none;
    border-top: var(--border-w) solid var(--rule);
    margin-top: var(--space-4);
    padding-top: var(--space-8);
  }
  /* 堆叠时不再强制等高均分，回归自然行高 */
  .series-list { flex: none; }
  .series-list > :global(*) { flex: none; }
}
@media (max-width: 640px) {
  .series-roman { font-size: 40px; }
  .series-title { font-size: 26px; }
}
</style>
